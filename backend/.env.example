# Connexion PostgreSQL
# Soit DATABASE_URL complet (prioritaire), soit les paramètres individuels ci-dessous.
# DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@localhost:5432/helpdesk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
POSTGRES_DB=helpdesk

# Délai max (secondes) pour établir une connexion à la base
DB_CONNECT_TIMEOUT=5

# Sécurité (à changer en dehors du développement)
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480

# Origines autorisées pour le CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Niveau de log : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
